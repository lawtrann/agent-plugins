#!/usr/bin/env bash
#MISE description="Run a plugin's evals, then bump its version in plugin.json (no check, no commit)"
#USAGE arg "<plugin>" help="Plugin name"
#USAGE arg "<level>" help="Which part of the version to increment" {
#USAGE   choices "patch" "minor" "major"
#USAGE }
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/mise/lib.sh"
require_claude
cd "$ROOT"

name="$usage_plugin"
dir="$(jq -r --arg n "$name" '.plugins[] | select(.name == $n) | .source | ltrimstr("./")' "$MARKETPLACE")"
[ -n "$dir" ] || die "'$name' is not an entry in marketplace.json."
manifest="$dir/.claude-plugin/plugin.json"

# A clean tree means the last commit passed the pre-commit check, and the evals run on committed code.
[ -z "$(git status --porcelain)" ] || die "the working tree has uncommitted changes. Commit or stash them first."

if [ -d "$dir/evals" ]; then
  echo "▸ claude plugin eval $dir"
  claude plugin eval "$dir" --no-publish || die "the evals failed. The version is unchanged."
else
  echo "▸ $dir has no evals/; skipping evals."
fi

old="$(jq -r .version "$manifest")"
new="$(jq -rn --arg v "$old" --arg level "$usage_level" '
  $v | split(".") | map(tonumber) |
  if $level == "major" then [.[0] + 1, 0, 0]
  elif $level == "minor" then [.[0], .[1] + 1, 0]
  else [.[0], .[1], .[2] + 1] end |
  map(tostring) | join(".")')"
jq --arg v "$new" '.version = $v' "$manifest" >"$manifest.tmp"
mv "$manifest.tmp" "$manifest"

echo "✔ $name: $old → $new"
echo "Next: git commit -am \"chore($name): v$new\"   (the pre-commit hook runs check)"
echo "Then: mise run plugin:tag $name"
