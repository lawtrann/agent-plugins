#!/usr/bin/env bash
#MISE description="Set up a fresh clone: install tools and the git hooks (pre-commit, commit-msg, pre-push)"
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/mise/lib.sh"
require_claude
cd "$ROOT"

mise install

# Git does not version hooks, so each clone installs them. Skip a hook that is already in place.
install_hook() { # <hook> <task>
  local path
  path="$(git rev-parse --git-path "hooks/$1")"
  if [ "$(cat "$path" 2>/dev/null)" = "$(mise generate git-pre-commit --hook "$1" --task "$2")" ]; then
    echo "$1 hook already installed"
  else
    mise generate git-pre-commit --write --hook "$1" --task "$2"
  fi
}
install_hook pre-commit "check --staged"
install_hook commit-msg commit-msg
install_hook pre-push pre-push

echo "✔ ready. Create a plugin with: mise run plugin:new <name> --kind skill|mod"
